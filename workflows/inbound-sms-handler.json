    {
      "parameters": {
        "jsCode": "// Prepare data for Claude API call\nconst webhook = $('Twilio Webhook').item.json;\nconst lead = $('Lookup Lead').item.json.phone ? $('Lookup Lead').item.json : $('Create New Lead').item.json;\nconst messages = $('Get Message History').all().map(item => item.json);\nconst configRows = $('Get Config').all().map(item => item.json);\n\n// Convert config rows to object\nconst config = {};\nconfigRows.forEach(row => {\n  config[row.key] = row.value;\n});\n\n// Get last 10 messages\nconst recentMessages = messages.slice(-10).map(m => ({\n  role: m.direction === 'in' ? 'user' : 'assistant',\n  content: m.text\n}));\n\n// Build the prompt\nconst userMessage = `\nCURRENT LEAD RECORD:\n${JSON.stringify(lead, null, 2)}\n\nCONFIG (business rules):\n${JSON.stringify(config, null, 2)}\n\nCONVERSATION HISTORY (last 10 messages):\n${JSON.stringify(recentMessages, null, 2)}\n\nLATEST INBOUND MESSAGE:\n\"${webhook.Body}\"\n\nRespond with valid JSON only.\n`;\n\nconst systemPrompt = `You are a scheduling assistant for a local pool cleaning company.\nGoal: convert inquiries into booked appointments or qualified leads.\n\nRules:\n- Be brief, friendly, professional. 1-2 short messages max.\n- Ask only one question at a time unless it's a multiple-choice list.\n- Always check service city first. If outside service area: politely decline.\n- Give price ranges only (unless config explicitly says exact pricing).\n- If uncertain, confused, or customer requests a human: set intent=handoff.\n- Output MUST be valid JSON only (no extra text).\n\nYou will receive:\n- config (service cities, price ranges, booking type, office hours)\n- last 10 messages\n- latest inbound message\n- current lead record\n\nDecide next best action and return JSON with:\nreply_text, lead_status, intent, fields_extracted, missing_fields, booking_request, handoff_reason.`;\n\nreturn {\n  lead,\n  config,\n  userMessage,\n  systemPrompt,\n  phone: webhook.From\n};"
      },
      "id": "prepare-claude-request",
      "name": "Prepare Claude Request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1450, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-api-key",
              "value": "={{ $credentials.anthropicApiKey }}"
            },
            {
              "name": "anthropic-version",
              "value": "2023-06-01"
            },
            {
              "name": "content-type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"claude-sonnet-4-20250514\",\n  \"max_tokens\": 1024,\n  \"system\": {{ JSON.stringify($('Prepare Claude Request').item.json.systemPrompt) }},\n  \"messages\": [\n    {\n      \"role\": \"user\",\n      \"content\": {{ JSON.stringify($('Prepare Claude Request').item.json.userMessage) }}\n    }\n  ]\n}",
        "options": {}
      },
      "id": "call-claude-api",
      "name": "Call Claude API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [1650, 300],
      "credentials": {
        "httpHeaderAuth": {
          "id": "ANTHROPIC_CREDENTIAL_ID",
          "name": "Anthropic API"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Parse Claude's JSON response\nconst response = $input.item.json;\nlet claudeOutput;\n\ntry {\n  // Extract text from Claude response\n  const text = response.content[0].text;\n  \n  // Parse the JSON\n  claudeOutput = JSON.parse(text);\n} catch (e) {\n  // Fallback if parsing fails\n  claudeOutput = {\n    reply_text: \"Thanks for reaching out! Let me connect you with someone who can help. We'll be in touch shortly.\",\n    lead_status: \"handoff\",\n    intent: \"handoff\",\n    fields_extracted: {},\n    missing_fields: [],\n    booking_request: null,\n    handoff_reason: \"Failed to parse AI response\"\n  };\n}\n\nreturn {\n  ...claudeOutput,\n  lead: $('Prepare Claude Request').item.json.lead,\n  phone: $('Prepare Claude Request').item.json.phone,\n  config: $('Prepare Claude Request').item.json.config\n};"
      },
      "id": "parse-claude-response",
