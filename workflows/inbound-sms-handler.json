    },
    "Update Lead": {
      "main": [[{ "node": "Log Outbound Message", "type": "main", "index": 0 }]]
    },
    "Log Outbound Message": {
      "main": [[{ "node": "Send SMS Reply", "type": "main", "index": 0 }]]
    },
    "Send SMS Reply": {
      "main": [[{ "node": "Respond to Webhook", "type": "main", "index": 0 }]]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
