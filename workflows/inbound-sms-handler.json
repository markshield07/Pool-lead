{
  "name": "Pool Lead - SMS Handler",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "pool-lead-sms",
        "responseMode": "onReceived",
        "options": {}
      },
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [250, 300]
    },
    {
      "parameters": {
        "operation": "append",
        "sheetId": "YOUR_SHEET_ID",
        "range": "Messages!A:D",
        "options": {}
      },
      "name": "Log Message",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 2,
      "position": [450, 300]
    },
    {
      "parameters": {
        "sheetId": "YOUR_SHEET_ID",
        "range": "Config!A:B",
        "options": {}
      },
      "name": "Get Config",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 2,
      "position": [650, 300]
    },
    {
      "parameters": {
        "requestMethod": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "jsonParameters": true,
        "options": {},
        "headerParametersUi": {
          "parameter": [
            { "name": "x-api-key", "value": "YOUR_CLAUDE_API_KEY" },
            { "name": "anthropic-version", "value": "2023-06-01" },
            { "name": "content-type", "value": "application/json" }
          ]
        },
        "bodyParametersJson": "={\"model\": \"claude-sonnet-4-20250514\", \"max_tokens\": 256, \"system\": \"You are a friendly scheduling assistant for a pool cleaning company. Help customers with quotes and scheduling. Be brief (1-2 sentences). Respond with JSON only: {\\\"reply_text\\\": \\\"your message\\\"}\", \"messages\": [{\"role\": \"user\", \"content\": \"Customer says: {{ $node['Webhook'].json.Body }}\"}]}"
      },
      "name": "Call Claude",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [850, 300]
    },
    {
      "parameters": {
        "functionCode": "let replyText;\ntry {\n  const text = $json.content[0].text;\n  const parsed = JSON.parse(text);\n  replyText = parsed.reply_text;\n} catch (e) {\n  replyText = 'Thanks for reaching out! Someone will get back to you soon.';\n}\n\nreturn [{ json: { reply_text: replyText, phone: $node['Webhook'].json.From, twilio_number: $node['Get Config'].json.twilio_number || $items('Get Config').find(i => i.json.key === 'twilio_number')?.json.value } }];"
      },
      "name": "Parse Response",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [1050, 300]
    },
    {
      "parameters": {
        "from": "={{ $json.twilio_number }}",
        "to": "={{ $json.phone }}",
        "message": "={{ $json.reply_text }}"
      },
      "name": "Send SMS",
      "type": "n8n-nodes-base.twilio",
      "typeVersion": 1,
      "position": [1250, 300]
    }
  ],
  "connections": {
    "Webhook": {
      "main": [[{ "node": "Log Message", "type": "main", "index": 0 }]]
    },
    "Log Message": {
      "main": [[{ "node": "Get Config", "type": "main", "index": 0 }]]
    },
    "Get Config": {
      "main": [[{ "node": "Call Claude", "type": "main", "index": 0 }]]
    },
    "Call Claude": {
      "main": [[{ "node": "Parse Response", "type": "main", "index": 0 }]]
    },
    "Parse Response": {
      "main": [[{ "node": "Send SMS", "type": "main", "index": 0 }]]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
